-- Infinite jump: tricks game into thinking an Antigravity Generator is active, allowing mid-air jumps
local OrigJammerOn = nil
local function infJumpWrapper(id, ...)
    -- disabled while Clear / Farmer runs (jumping must behave normally)
    if Misc.InfJump and id == 4992 and not AutoInput.active then
        return true
    end
    if OrigJammerOn then return OrigJammerOn(id, ...) end
    return false
end

local function hookJammer()
    local w = Refs.World
    if not w then return end
    local cur = rawget(w, "jammerOn")
    if cur == infJumpWrapper or type(cur) ~= "function" then return end
    OrigJammerOn = cur
    w.jammerOn = infJumpWrapper
end

local function unhookJammer()
    local w = Refs.World
    if w and rawget(w, "jammerOn") == infJumpWrapper and OrigJammerOn then
        w.jammerOn = OrigJammerOn
    end
end

local function setInfJump(on)
    Misc.InfJump = on
    if on then hookJammer() else unhookJammer() end
end

local function setSpeed(pct)
    Misc.Speed = math.clamp(math.floor(tonumber(pct) or 100), 50, 500)
    if Misc.Speed == 100 and Refs.World then Refs.World.speedScale = 1 end
end

-- Game movement keys are read from WorldMenu.isDown. Hooked so
-- Clear / Farmer can press virtual keys and manual input cancels Path Glide.
local OrigIsDown = nil
local function isDownWrapper(saved, key, ...)
    if AutoInput.active then
        if key == "keyLeft" then return AutoInput.left end
        if key == "keyRight" then return AutoInput.right end
        if key == "keyJump" then return AutoInput.jump end
        if key == "keyDown" then return AutoInput.down end
    end
    local down = OrigIsDown(saved, key, ...)
    if down and Misc.PathGlide and (key == "keyLeft" or key == "keyRight" or key == "keyJump" or key == "keyDown") then
        if Session.stopPathGlide then Session.stopPathGlide() end
    end
    return down
end

function Session.tryMovementMenu(menu)
    if type(menu) ~= "table" then return false end
    local original = rawget(menu, "isDown")
    if original == isDownWrapper then return Session.MovementMenu == menu and OrigIsDown ~= nil end
    if type(original) ~= "function" then return false end
    local ok, reason = pcall(rawset, menu, "isDown", isDownWrapper)
    if not ok then
        warn("[Fian] Could not hook movement controls: " .. tostring(reason))
        return false
    end
    local previous = Session.MovementMenu
    if previous and previous ~= menu and rawget(previous, "isDown") == isDownWrapper then
        pcall(rawset, previous, "isDown", OrigIsDown)
    end
    Session.MovementMenu, OrigIsDown = menu, original
    Session.MovementReady = true
    MenuModule, MenuModOk = menu, true
    return true
end

function Session.bindMovement(retry, deep)
    if Session.tryMovementMenu(Refs.MovementMenu) then return true end
    if Session.tryMovementMenu(Session.MovementMenu or MenuModule) then return true end
    if not retry then return false end
    pcall(Anim.quickRefs)
    if Session.tryMovementMenu(Refs.MovementMenu) then return true end
    if Session.tryMovementMenu(Session.resolveMovement()) then return true end
    if deep then
        pcall(findRefs)
        if Session.tryMovementMenu(Refs.MovementMenu) then return true end
    end
    return false
end
Session.bindMovement()

function Session.scheduleMovementRetry()
    if OrigIsDown or Session.MovementRetry then return end
    Session.MovementRetry = true
    task.spawn(function()
        for _, delay in ipairs({ 1, 2, 4 }) do
            task.wait(delay)
            if not alive() or OrigIsDown then break end
            if not Session.Connecting then Session.bindMovement(true) end
            if OrigIsDown then
                UI.later("movement-ready", function()
                    pcall(function() UI.RefInfo:SetDesc(refsText()) end)
                end)
                break
            end
        end
        Session.MovementRetry = false
    end)
end

-- Apply walkspeed and step Path Glide before/after game physics ticks.
do (function()
    local env = type(getfenv) == "function" and getfenv(0) or _G
    local setUp = (debug and debug.setupvalue) or rawget(env, "setupvalue") or rawget(G, "setupvalue") or rawget(_G, "setupvalue")
    local stateFnRef, stateUpIdx, lastRefRefresh = nil, nil, 0

    local function bindStateUpvals()
        if type(setUp) ~= "function" or not Refs.State then return nil end
        if stateFnRef == Refs.State and stateUpIdx then return stateUpIdx end
        local ok, s = pcall(Refs.State)
        if not ok or type(s) ~= "table" or type(s.x) ~= "number" or type(s.y) ~= "number" or s.x == s.y then
            return nil
        end
        local ups = getUpvalues(Refs.State)
        local xIdx, yIdx, gIdx, vxIdx, vyIdx, fIdx
        local xCount, yCount, vxCount, vyCount = 0, 0, 0, 0
        for idx, v in pairs(ups) do
            if type(idx) == "number" then
                if v == s.x then xIdx = idx; xCount += 1 end
                if v == s.y then yIdx = idx; yCount += 1 end
                if type(s.vx) == "number" and s.vx ~= s.vy and v == s.vx then vxIdx = idx; vxCount += 1 end
                if type(s.vy) == "number" and s.vx ~= s.vy and v == s.vy then vyIdx = idx; vyCount += 1 end
                if idx == 8 and type(v) == "boolean" and v == s.grounded then gIdx = 8 end
            end
        end
        if xCount == 1 and yCount == 1 then
            if vxCount == 0 and vyCount == 0 and yIdx and type(s.vx) == "number" and type(s.vy) == "number"
               and ups[yIdx + 1] == s.vx and ups[yIdx + 2] == s.vy then
                vxIdx = yIdx + 1; vxCount = 1
                vyIdx = yIdx + 2; vyCount = 1
            end
            if yIdx and type(s.facing) == "number" and (s.facing == 1 or s.facing == -1) and ups[yIdx + 3] == s.facing then
                fIdx = yIdx + 3
            end
            stateFnRef = Refs.State
            stateUpIdx = {
                x = xIdx, y = yIdx, grounded = gIdx, facing = fIdx,
                vx = vxCount == 1 and vxIdx or nil,
                vy = vyCount == 1 and vyIdx or nil,
            }
            return stateUpIdx
        end
        return nil
    end

    function Session.writeStatePos(px, py, clearGround, facing, vx, vy)
        local idx = bindStateUpvals()
        if not idx or not Refs.State then return false end
        if px then pcall(setUp, Refs.State, idx.x, px) end
        if py then pcall(setUp, Refs.State, idx.y, py) end
        if clearGround and idx.grounded then pcall(setUp, Refs.State, idx.grounded, false) end
        if idx.facing and (facing == 1 or facing == -1) then pcall(setUp, Refs.State, idx.facing, facing) end
        if idx.vx then pcall(setUp, Refs.State, idx.vx, vx or 0) end
        if idx.vy then pcall(setUp, Refs.State, idx.vy, vy or 0) end
        return true
    end

    function Session.readState()
        if not Refs.State then return nil end
        local ok, s = pcall(Refs.State)
        if ok and type(s) == "table" and type(s.x) == "number" and type(s.y) == "number"
            and s.active ~= false and not s.dead then
            return s
        end
        return nil
    end

    local function applyWorldProps(w)
        if Misc.Speed ~= 100 then w.speedScale = Misc.Speed / 100 end
    end

    local function ensureLiveRefs()
        local now = os.clock()
        if now - lastRefRefresh < 2 then return end
        local w = Refs.World
        local staleWorld = (not w) or type(rawget(w, "fg")) ~= "table" or type(rawget(w, "w")) ~= "number"
        if staleWorld or not Refs.State then
            lastRefRefresh = now
            if staleWorld then Refs.World = nil end
            pcall(Anim.quickRefs)
            pcall(Session.bindMovement, true)
        end
    end

    pcall(function()
        RunService:BindToRenderStep("Fian_MiscPreRender", Enum.RenderPriority.First.Value - 10, function()
            if not alive() then return end
            local w = Refs.World
            if w then applyWorldProps(w) end
            if Session.preRenderPathGlide then Session.preRenderPathGlide() end
        end)
    end)

    table.insert(Connections, RunService.Stepped:Connect(function()
        if not alive() then return end
        local w = Refs.World
        if w then applyWorldProps(w) end
    end))

    table.insert(Connections, RunService.Heartbeat:Connect(function()
        if not alive() then return end
        if Misc.PathGlide or Misc.Speed ~= 100 then ensureLiveRefs() end
        local w = Refs.World
        if not w then return end
        applyWorldProps(w)
        if Session.stepPathGlide then Session.stepPathGlide() end
    end))
end)() end

